# RELEASE - Location of external support modules
# The paths are those of the INFN IOC image (ghcr.io/infn-epics/infn-epics-ioc-base); put
# local overrides in RELEASE.local, which is read last.

SUPPORT=/epics/support
ASYN=$(SUPPORT)/asyn
SNCSEQ=$(SUPPORT)/sequencer

# EPICS_BASE usually appears last so other apps can override stuff:
EPICS_BASE=/epics/epics-base

-include $(TOP)/configure/RELEASE.local
