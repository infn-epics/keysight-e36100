/*
 * e36100SafeOff.st - Ramp to 0 V, then switch the output off
 *
 * Generated by the ARGUS IOC engineer (ioc_scaffold_module) from the module's description.
 *
 * Steps:
 *   1. set Voltage_SP to 0, then wait until Voltage_RB < 0.05 (10 s)
 *   2. set Output_SP to 0, then wait until Output_RB == 0 (6 s)
 *
 * $(P):$(R):SafeOff:Start = 1 starts it; $(P):$(R):SafeOff:Abort = 1 stops it at the current step. A step's command is
 * sent again every RETRY_DELAY seconds until its condition holds; after the step's timeout the program stops in
 * Failed, with the value it last read in $(P):$(R):SafeOff:Message.
 */
program e36100SafeOff("P=TEST:PS:E36100,R=PS01,RETRY_DELAY=2")

option +r;

%%#include <stdio.h>
%%#include <stdlib.h>
%%#include <string.h>

%{
static double macDouble(const char *text, double fallback)
{
    double value = (text && *text) ? atof(text) : 0.0;
    return value > 0.0 ? value : fallback;
}
}%

double retryDelay;
int tries;
int maxTries;

int startCmd;
assign startCmd to "{P}:{R}:SafeOff:Start";
monitor startCmd;

int abortCmd;
assign abortCmd to "{P}:{R}:SafeOff:Abort";
monitor abortCmd;

int seqState;
assign seqState to "{P}:{R}:SafeOff:State";

int seqStep;
assign seqStep to "{P}:{R}:SafeOff:Step";

string message;
assign message to "{P}:{R}:SafeOff:Message";

double sp_Voltage;
assign sp_Voltage to "{P}:{R}:Voltage_SP";

double sp_Output;
assign sp_Output to "{P}:{R}:Output_SP";

double rb_Voltage;
assign rb_Voltage to "{P}:{R}:Voltage_RB";
monitor rb_Voltage;

double rb_Output;
assign rb_Output to "{P}:{R}:Output_RB";
monitor rb_Output;

ss e36100SafeOff {

    state init {
        when () {
            retryDelay = macDouble(macValueGet("RETRY_DELAY"), 2);
            seqState = 0;
            pvPut(seqState);
            seqStep = 0;
            pvPut(seqStep);
        } state idle
    }

    state idle {
        when (startCmd) {
            startCmd = 0;
            pvPut(startCmd);
            abortCmd = 0;
            pvPut(abortCmd);
            tries = 1;
            maxTries = (int)(10 / retryDelay) + 1;
            sp_Voltage = 0;
            pvPut(sp_Voltage);
        } state step1
        when (abortCmd) {
            abortCmd = 0;
            pvPut(abortCmd);
        } state idle
    }

    /* Step 1: Voltage_SP=0, Voltage_RB<0.05 */
    state step1 {
        entry {
            seqState = 1;
            pvPut(seqState);
            seqStep = 1;
            pvPut(seqStep);
            strcpy(message, "1: Voltage_SP=0, Voltage_RB<0.05");
            pvPut(message);
        }
        when (abortCmd) {
        } state aborted
        when (rb_Voltage < 0.05) {
            tries = 1;
            maxTries = (int)(6 / retryDelay) + 1;
            sp_Output = 0;
            pvPut(sp_Output);
        } state step2
        when (delay(retryDelay) && tries < maxTries) {
            tries++;
            pvPut(sp_Voltage);
        } state step1
        when (delay(retryDelay)) {
            sprintf(message, "1: timeout, Voltage_RB=%g", rb_Voltage);
            pvPut(message);
        } state failed
    }

    /* Step 2: Output_SP=0, Output_RB==0 */
    state step2 {
        entry {
            seqState = 1;
            pvPut(seqState);
            seqStep = 2;
            pvPut(seqStep);
            strcpy(message, "2: Output_SP=0, Output_RB==0");
            pvPut(message);
        }
        when (abortCmd) {
        } state aborted
        when (rb_Output == 0) {

        } state done
        when (delay(retryDelay) && tries < maxTries) {
            tries++;
            pvPut(sp_Output);
        } state step2
        when (delay(retryDelay)) {
            sprintf(message, "2: timeout, Output_RB=%g", rb_Output);
            pvPut(message);
        } state failed
    }

    state done {
        entry {
            seqState = 2;
            pvPut(seqState);
            strcpy(message, "Done");
            pvPut(message);
        }
        when () {
        } state idle
    }

    state failed {
        entry {
            seqState = 3;
            pvPut(seqState);
        }
        when () {
        } state idle
    }

    state aborted {
        entry {
            seqState = 4;
            pvPut(seqState);
            strcpy(message, "Aborted");
            pvPut(message);
            abortCmd = 0;
            pvPut(abortCmd);
        }
        when () {
        } state idle
    }
}
