# e36100.template - Keysight E36100B series DC power supply (E36103B 20 V / 2 A)
# Generated by the ARGUS IOC engineer (ioc_scaffold_module) from the module's description.
#
# Macros: P, R, PORT, TIMEOUT. Each quantity the device reads is $(P):$(R):<name>_RB, each it sets
# $(P):$(R):<name>_SP.
#
#   dbLoadRecords("db/e36100.template", "P=TEST:PS:E36100,R=PS01,PORT=PS01")

record(bi, "$(P):$(R):Connected") {
    field(DESC, "Device answers the poll")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0,$(TIMEOUT=1))CONNECTED")
    field(SCAN, "I/O Intr")
    field(ZNAM, "Disconnected")
    field(ONAM, "Connected")
    field(ZSV,  "MAJOR")
}

record(ai, "$(P):$(R):Voltage_RB") {
    field(DESC, "Output voltage readback")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),0,$(TIMEOUT=1))Voltage_RB")
    field(SCAN, "I/O Intr")
    field(EGU,  "V")
    field(PREC, "4")
}

record(ao, "$(P):$(R):Voltage_SP") {
    field(DESC, "Output voltage setpoint")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),0,$(TIMEOUT=1))Voltage_SP")
    field(EGU,  "V")
    field(PREC, "4")
    field(DRVL, "0")
    field(DRVH, "20")
    info(autosaveFields, "VAL")
}

