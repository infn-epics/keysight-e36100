#!../../bin/linux-x86_64/e36100

## Keysight E36100B series DC power supply (E36103B 20 V / 2 A): the example IOC
## Generated by the ARGUS IOC engineer (ioc_scaffold_module) from the module's description.

< envPaths

## Register all support components
dbLoadDatabase "../../dbd/e36100.dbd"
e36100_registerRecordDeviceDriver pdbbase

## drvAsynIPPortConfigure("portName", "hostname:port", priority, noAutoConnect, noProcessEos)
drvAsynIPPortConfigure("PS01_IO", "192.168.1.60:5025", 0, 0, 0)
## Optional: asyn tracing for debugging
# asynSetTraceMask("PS01_IO", 0, 0x9)
# asynSetTraceIOMask("PS01_IO", 0, 0x2)
asynOctetSetInputEos("PS01_IO", 0, "\n")
asynOctetSetOutputEos("PS01_IO", 0, "\n")
## e36100Configure(portName, octetPort, pollPeriod, timeout)
e36100Configure("PS01", "PS01_IO", 1, 2)

dbLoadRecords("../../db/e36100.template", "P=TEST:PS:E36100,R=PS01,PORT=PS01,TIMEOUT=2")
dbLoadRecords("../../db/e36100RampOn.template", "P=TEST:PS:E36100,R=PS01")
dbLoadRecords("../../db/e36100SafeOff.template", "P=TEST:PS:E36100,R=PS01")

iocInit

## Start the state programs
seq e36100RampOn, "P=TEST:PS:E36100,R=PS01,RETRY_DELAY=2"
seq e36100SafeOff, "P=TEST:PS:E36100,R=PS01,RETRY_DELAY=2"
